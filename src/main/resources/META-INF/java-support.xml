<idea-plugin>
    <projectListeners>
        <!-- Java run configurations carry the VM options, arguments, and environment Spring reads. -->
        <listener
            class="com.github.khopland.symbols.ActiveSpringProfileListener"
            topic="com.intellij.execution.RunManagerListener"/>
    </projectListeners>
    <extensions defaultExtensionNs="com.github.khopland.symbols">
        <classStereotypeSupport implementation="com.github.khopland.symbols.JavaClassStereotypeSupport"/>
    </extensions>
</idea-plugin>
