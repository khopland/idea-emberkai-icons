<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Without XML support no detector exists, so XML files keep their mapped icon. -->
        <applicationService
            serviceInterface="com.github.khopland.emberkai.rules.SpringXmlConfigDetector"
            serviceImplementation="com.github.khopland.emberkai.rules.DomSpringXmlConfigDetector"/>
    </extensions>
</idea-plugin>
