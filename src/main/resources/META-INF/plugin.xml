<idea-plugin>
    <!--
        The code lives in com.github.khopland.emberkai, but the plugin ID and every ID under it (extension points,
        actions, the configurable, the status bar widget) keep the original com.github.khopland.symbols prefix:
        Marketplace upgrades, keymaps, toolbars, and saved widget settings refer to them.
    -->
    <id>com.github.khopland.symbols</id>
    <name>Emberkai Icons</name>
    <vendor url="https://github.com/khopland/idea-emberkai-icons">khopland</vendor>
    <description><![CDATA[
        <p>File and folder icons that also show what each file does and whether it needs your attention.
        More than 450 icons, all drawn in one faceted style as a companion to the Emberkai theme.
        Java and Kotlin keep IntelliJ's own type icons and markers.</p>

        <p><b>Class roles at a glance</b></p>
        <ul>
          <li>Spring, Quarkus, Micronaut, and JPA classes show their role in place of the letter in a circle:
          applications, controllers, message listeners, scheduled jobs, HTTP clients, services, repositories,
          configuration, and entities.</li>
          <li>Test classes show what they start: containers, the whole application, or a Spring Boot test slice.</li>
          <li>Next.js and NestJS files, and FastAPI, Flask, Django, Celery, and SQLAlchemy modules, get the same
          roles as a small corner glyph.</li>
        </ul>

        <p><b>Production and problems stand out</b></p>
        <ul>
          <li>Production, staging, test, and local variants of Spring profiles, Docker Compose files, Helm values,
          <code>.env</code> files, and environment folders such as <code>overlays/production/</code> get a
          shape-and-color badge. Production files open with a red editor tab and a warning banner.</li>
          <li>A red badge marks private keys, keystores, <code>.env</code> files, and registry tokens that sit in
          a VCS root without being ignored, and Kubernetes manifests with a plaintext Secret.</li>
          <li>An amber badge marks Flyway versions that collide or land below the default branch, repeated
          Liquibase changeSets, a stale Helm <code>Chart.lock</code>, unpinned GitHub Actions and
          <code>latest</code> images, and config variants that lack a key their siblings define.</li>
          <li>Live markers show the Spring profiles the selected run configuration activates, and which module
          is running or being debugged, with its port.</li>
        </ul>

        <p><b>Lenses</b></p>
        <p><b>View | Emberkai Icons | Lens</b> keeps the files that answer one question in full color and dims the
        rest of the Project view: <b>Production blast radius</b>, <b>Entry points</b>, <b>Infrastructure</b>,
        <b>API contracts</b>, <b>Database migrations</b>, <b>Changed on this branch</b>, <b>Hotspots</b>,
        <b>Failing tests</b>, <b>Depends on</b> a module, and <b>Owned by</b> any CODEOWNERS owner.
        The same recognition powers <b>Emberkai</b> scopes for Find in Files, inspections, and File Colors.</p>

        <p><b>Recognized by content, not just name</b></p>
        <p>Kubernetes manifests by <code>kind</code>, Helm charts, Kustomize, Flux, Argo CD, Terraform and
        OpenTofu, Ansible, CloudFormation, OpenAPI and AsyncAPI contracts, Avro schemas, Flyway and Liquibase
        migrations, SOPS, Sealed Secrets, and External Secrets, Spring, Quarkus, Micronaut, and Ktor
        configuration, CI pipelines from GitHub Actions to Tekton and Bazel, and dozens of developer tools.</p>

        <p><b>Easy to learn, easy to tune</b></p>
        <ul>
          <li>Each corner of an icon means one thing. <b>View | Emberkai Icons | Icon Legend</b> shows every mark,
          and <b>Explain This Icon</b> on any file says what its marks mean and which rule chose it.</li>
          <li>Pick <b>Icons only</b>, <b>Recommended</b>, or <b>Everything</b> under
          <b>Settings | Appearance &amp; Behavior | Emberkai Icons</b>, with a live preview, Catppuccin, Nord, and
          Gruvbox palettes, and colorblind-friendly, high-contrast, monochrome, and reduced-color folder modes.</li>
          <li>CODEOWNERS owners appear in tooltips, and <b>Tools | Find Reviewers for This Branch</b> lists the
          owners of every file the branch changes.</li>
        </ul>

        <p>File associations derived from
        <a href="https://github.com/miguelsolorio/vscode-symbols">vscode-symbols</a> by Miguel Solorio.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="spring-modulith.xml">com.intellij.spring.modulith</depends>
    <!-- 263 moved VCS out of the core into this plugin; older builds lack the ID and serve the classes from the core. -->
    <depends optional="true" config-file="platform-vcs.xml">com.intellij.platform.vcs</depends>
    <depends optional="true" config-file="vcs-secrets.xml">com.intellij.modules.vcs</depends>
    <!-- 263 moved the test runner out of the core into this plugin, as it did with VCS. -->
    <depends optional="true" config-file="platform-test-runner.xml">com.intellij.platform.testRunner</depends>
    <depends optional="true" config-file="test-failures.xml">com.intellij.modules.lang</depends>
    <depends optional="true" config-file="git.xml">Git4Idea</depends>
    <depends optional="true" config-file="spring-xml.xml">com.intellij.modules.xml</depends>
    <depends optional="true" config-file="java-support.xml">com.intellij.java</depends>
    <depends optional="true" config-file="kotlin-stereotypes.xml">org.jetbrains.kotlin</depends>
    <extensionPoints>
        <extensionPoint qualifiedName="com.github.khopland.symbols.classStereotypeSupport"
                        interface="com.github.khopland.emberkai.stereotypes.ClassStereotypeSupport"
                        dynamic="true"/>
        <extensionPoint qualifiedName="com.github.khopland.symbols.iconDecorator"
                        interface="com.github.khopland.emberkai.core.IconDecorator"
                        dynamic="true"/>
    </extensionPoints>
    <!--
        Badges and markers run in this order, each wrapping the icon the previous one produced. Each
        corner holds one badge (see BadgeSlot), so which badge is drawn depends on urgency, not on this order.
    -->
    <extensions defaultExtensionNs="com.github.khopland.symbols">
        <iconDecorator implementation="com.github.khopland.emberkai.node.NodeStereotypeDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.python.PythonStereotypeDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.EnvironmentVariantDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.UnignoredSecretDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.ConfigDriftDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.spring.ActiveSpringProfileDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.MigrationConflictDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.HelmLockDriftDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.badges.UnpinnedReferenceDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.accents.ModuleAccentDecorator"/>
        <iconDecorator implementation="com.github.khopland.emberkai.run.RunningServiceDecorator"/>
    </extensions>
    <!-- The Kotlin stereotype support reads only stub-backed PSI, which both Kotlin plugin modes provide. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <applicationListeners>
        <listener class="com.github.khopland.emberkai.badges.FlywayMigrationCacheListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.rules.OpenTofuSignalCacheListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.badges.HelmLockDriftListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.node.NodePackageListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.python.PythonProjectListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.badges.ConfigDriftListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.github.khopland.emberkai.statusbar.StatusBarWidgetVisibility"
                  topic="com.github.khopland.emberkai.lens.LensSettingsListener"/>
    </applicationListeners>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="appearance"
            instance="com.github.khopland.emberkai.ui.EmberkaiIconsConfigurable"
            id="com.github.khopland.symbols.EmberkaiIconsConfigurable"
            displayName="Emberkai Icons"/>
        <applicationConfigurable
            parentId="com.github.khopland.symbols.EmberkaiIconsConfigurable"
            instance="com.github.khopland.emberkai.editor.EditorWarningsConfigurable"
            id="com.github.khopland.symbols.EditorWarnings"
            displayName="Editor Warnings"/>
        <applicationConfigurable
            parentId="com.github.khopland.symbols.EmberkaiIconsConfigurable"
            instance="com.github.khopland.emberkai.lens.LensSettingsConfigurable"
            id="com.github.khopland.symbols.Lenses"
            displayName="Lenses"/>
        <!-- Content facts for scopes, lenses, and badges; the EDT and dumb mode still read files directly. -->
        <fileBasedIndex implementation="com.github.khopland.emberkai.rules.ContentIndex"/>
        <iconProvider implementation="com.github.khopland.emberkai.core.EmberkaiIconProvider" order="first"/>
        <fileIconProvider implementation="com.github.khopland.emberkai.core.EmberkaiIconProvider" order="first"/>
        <projectViewNodeDecorator implementation="com.github.khopland.emberkai.tooltips.SemanticTooltipDecorator"/>
        <projectViewNodeDecorator implementation="com.github.khopland.emberkai.lens.IconLensDecorator"/>
        <projectViewNodeDecorator implementation="com.github.khopland.emberkai.generated.GeneratedFileDecorator"/>
        <notificationGroup id="Emberkai Icons" displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.khopland.emberkai.ui.WelcomeNotificationActivity"/>
        <statusBarWidgetFactory id="com.github.khopland.symbols.StatusBar"
                                implementation="com.github.khopland.emberkai.statusbar.EmberkaiStatusBarWidgetFactory"/>
        <editorTabColorProvider implementation="com.github.khopland.emberkai.editor.ProductionEditorTabColorProvider"/>
        <editorNotificationProvider implementation="com.github.khopland.emberkai.editor.ProductionEditorNotificationProvider"/>
        <generatedSourcesFilter implementation="com.github.khopland.emberkai.generated.EmberkaiGeneratedSourcesFilter"/>
        <customScopesProvider implementation="com.github.khopland.emberkai.scopes.EmberkaiScopesProvider"/>
        <localInspection shortName="EmberkaiUnmatchedCodeOwnersPattern"
                         displayName="CODEOWNERS pattern matches nothing"
                         groupName="Emberkai"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.khopland.emberkai.ownership.UnmatchedCodeOwnersPatternInspection"/>
        <!-- Sends exception and UI freeze reports to JetBrains Marketplace (Freezes/Exceptions tabs). -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>
    <actions>
        <group id="com.github.khopland.symbols.EmberkaiQuickToggles"
               text="Emberkai Icons"
               popup="true">
            <action id="com.github.khopland.symbols.ShowIconLegend"
                    class="com.github.khopland.emberkai.audit.ShowIconLegendAction"
                    text="Icon Legend…"
                    description="Show what every Emberkai badge, corner mark, and folder color means">
                <add-to-group group-id="ToolsMenu" anchor="last"/>
            </action>
            <separator/>
            <group id="com.github.khopland.symbols.IconLens"
                   class="com.github.khopland.emberkai.lens.IconLensActionGroup"
                   text="Lens"
                   description="Keep files that answer one question in full color and dim the rest of the Project view"
                   popup="true"/>
            <separator/>
            <action id="com.github.khopland.symbols.ToggleServiceFolderColors"
                    class="com.github.khopland.emberkai.ui.ToggleServiceFolderColorsAction"
                    text="Color service folders"
                    description="Color folders that contain a Gradle, Maven, or Node package manifest"/>
            <action id="com.github.khopland.symbols.ToggleModuleAwareColors"
                    class="com.github.khopland.emberkai.ui.ToggleModuleAwareColorsAction"
                    text="Module-aware accent colors"
                    description="Give every IntelliJ module a stable folder accent color"/>
            <action id="com.github.khopland.symbols.ToggleHighContrastFolders"
                    class="com.github.khopland.emberkai.ui.ToggleHighContrastFoldersAction"
                    text="High-contrast folder markers"
                    description="Use shape-coded high-contrast folder markers"/>
            <action id="com.github.khopland.symbols.ToggleMonochromeFolders"
                    class="com.github.khopland.emberkai.ui.ToggleMonochromeFoldersAction"
                    text="Monochrome service folders"
                    description="Draw service folders without color"/>
            <action id="com.github.khopland.symbols.ToggleReducedFolderColor"
                    class="com.github.khopland.emberkai.ui.ToggleReducedFolderColorAction"
                    text="Reduce service-folder color"
                    description="Use softer service-folder colors"/>
            <action id="com.github.khopland.symbols.ToggleArchitectureFolders"
                    class="com.github.khopland.emberkai.ui.ToggleArchitectureFoldersAction"
                    text="JVM architecture folders"
                    description="Show distinct icons for controller, service, repository, and similar packages"/>
            <action id="com.github.khopland.symbols.ToggleStereotypeBadges"
                    class="com.github.khopland.emberkai.ui.ToggleStereotypeBadgesAction"
                    text="Class stereotype icons"
                    description="Show a role icon in place of the native class icon for controllers, message listeners, scheduled jobs, HTTP clients, services, repositories, configuration, entities, and tests"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </group>
        <action id="com.github.khopland.symbols.ExplainIcon"
                class="com.github.khopland.emberkai.audit.ExplainIconAction"
                text="Explain This Icon"
                description="Show what this icon's marks mean and which Emberkai rule or mapping selected it">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AssignModuleAccentColor"
                class="com.github.khopland.emberkai.accents.AssignModuleAccentAction"
                text="Assign Module Accent Color…"
                description="Pin a folder accent color for the module that owns this directory">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.ResetAllModuleAccentColors"
                class="com.github.khopland.emberkai.accents.ResetAllModuleAccentColorsAction"
                text="Reset All Module Accent Colors"
                description="Return every module to its automatic accent color">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AuditProjectIconCoverage"
                class="com.github.khopland.emberkai.audit.AuditProjectIconCoverageAction"
                text="Audit Project Icon Coverage"
                description="Find files that use generic or unmapped icons">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AuditDirectoryIconCoverage"
                class="com.github.khopland.emberkai.audit.AuditDirectoryIconCoverageAction"
                text="Audit Icon Coverage"
                description="Find generic or unmapped icons under this directory">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.OverrideIcon"
                class="com.github.khopland.emberkai.overrides.OverrideIconAction"
                text="Override This Icon…"
                description="Create a project-local icon override for this file or folder">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.OpenIconOverrides"
                class="com.github.khopland.emberkai.overrides.OpenIconOverridesAction"
                text="Open Icon Overrides File"
                description="Open or create .idea/emberkai-icons.properties">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.ReloadIconOverrides"
                class="com.github.khopland.emberkai.overrides.ReloadIconOverridesAction"
                text="Reload Icon Overrides"
                description="Reload project-local icon overrides">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.BrowseIconCatalog"
                class="com.github.khopland.emberkai.overrides.BrowseIconCatalogAction"
                text="Browse Bundled Icons"
                description="Search every bundled icon and copy its mapping key or path">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
