<idea-plugin>
    <id>com.github.khopland.symbols</id>
    <name>Emberkai Icons</name>
    <vendor url="https://github.com/khopland/idea-emberkai-icons">khopland</vendor>
    <description><![CDATA[
        <p>Emberkai Icons brings the Symbols file and folder icon set to JetBrains IDEs,
        as a companion to the Emberkai theme.</p>
        <p>Java and Kotlin declarations keep their native IntelliJ type icons and badges.</p>
        <p>Gradle Kotlin build scripts and version catalogs use Gradle icons.
        Spring Boot configuration and Helm charts have context-aware icons, and Spring XML
        configuration uses Emberkai artwork. Spring Modulith package locks are painted onto
        Emberkai folders when that plugin is installed.</p>
        <p>Includes CI pipelines, Ansible, infrastructure as code, database migrations,
        OpenAPI contracts, Kubernetes, Kustomize, Flux, and Argo CD,
        developer-tool configuration, and test assets.</p>
        <p>Symbols-style project folders retain source/test colors, resource and
        package markers, and blue module/source-set badges, including Kotlin Multiplatform.
        Opt-in module-aware accents give every IntelliJ module a stable color that service roots,
        source roots, packages, and their descendants share. Opt-in JVM architecture folders give
        controller, service, repository, domain, and similar packages distinct icons.</p>
        <p>Production, staging, test, and local variants of Spring profiles, Docker Compose files,
        Helm values, and <code>.env</code> files get shape-and-color environment badges.
        Private keys, keystores, <code>.env</code> files, and similar credentials that sit in a VCS root
        without being ignored get a red stop-sign warning badge. Spring profile files activated by the
        selected run configuration get a ring-and-dot live marker. Spring controllers, services,
        repositories, configuration classes, and JPA entities keep their native Java/Kotlin class icons
        with a small stereotype badge.</p>
        <p>Configure everything under <b>Settings | Appearance &amp; Behavior | Emberkai Icons</b>
        with a live preview, including accessibility modes: a colorblind-friendly palette,
        high-contrast markers, monochrome folders, and reduced folder color. Quick toggles live in
        <b>View | Emberkai Icons</b>.</p>
        <p>Right-click any file or folder and choose <b>Explain This Icon</b> to see which rule or
        mapping selected it. Project view tooltips describe recognized tool files, project roles,
        environment variants, and module accents. Run <b>Tools | Audit Project Icon Coverage</b>
        to find files that still use generic icons.</p>
        <p>Emberkai scopes such as <b>Emberkai: Database migrations</b> and <b>Emberkai: Production config</b>
        use the same recognition in Find in Files, the Project view, inspections, and File Colors.</p>
        <p>Icons by Miguel Solorio, from
        <a href="https://github.com/miguelsolorio/vscode-symbols">vscode-symbols</a>.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="spring-modulith.xml">com.intellij.spring.modulith</depends>
    <depends optional="true" config-file="vcs-secrets.xml">com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="java-active-profiles.xml">com.intellij.java</depends>
    <depends optional="true" config-file="java-stereotypes.xml">com.intellij.java</depends>
    <depends optional="true" config-file="kotlin-stereotypes.xml">org.jetbrains.kotlin</depends>
    <extensionPoints>
        <extensionPoint qualifiedName="com.github.khopland.symbols.classStereotypeSupport"
                        interface="com.github.khopland.symbols.ClassStereotypeSupport"
                        dynamic="true"/>
    </extensionPoints>
    <!-- The Kotlin stereotype support reads only stub-backed PSI, which both Kotlin plugin modes provide. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="appearance"
            instance="com.github.khopland.symbols.EmberkaiIconsConfigurable"
            id="com.github.khopland.symbols.EmberkaiIconsConfigurable"
            displayName="Emberkai Icons"/>
        <iconProvider implementation="com.github.khopland.symbols.SymbolsIconProvider" order="first"/>
        <fileIconProvider implementation="com.github.khopland.symbols.SymbolsIconProvider" order="first"/>
        <projectViewNodeDecorator implementation="com.github.khopland.symbols.SemanticTooltipDecorator"/>
        <customScopesProvider implementation="com.github.khopland.symbols.EmberkaiScopesProvider"/>
        <iconLayerProvider implementation="com.github.khopland.symbols.ClassStereotypeLayerProvider"/>
    </extensions>
    <actions>
        <group id="com.github.khopland.symbols.EmberkaiQuickToggles"
               text="Emberkai Icons"
               popup="true">
            <action id="com.github.khopland.symbols.ToggleServiceFolderColors"
                    class="com.github.khopland.symbols.ToggleServiceFolderColorsAction"
                    text="Color service folders"
                    description="Color folders that contain a Gradle, Maven, or Node package manifest"/>
            <action id="com.github.khopland.symbols.ToggleModuleAwareColors"
                    class="com.github.khopland.symbols.ToggleModuleAwareColorsAction"
                    text="Module-aware accent colors"
                    description="Give every IntelliJ module a stable folder accent color"/>
            <action id="com.github.khopland.symbols.ToggleHighContrastFolders"
                    class="com.github.khopland.symbols.ToggleHighContrastFoldersAction"
                    text="High-contrast folder markers"
                    description="Use shape-coded high-contrast folder markers"/>
            <action id="com.github.khopland.symbols.ToggleMonochromeFolders"
                    class="com.github.khopland.symbols.ToggleMonochromeFoldersAction"
                    text="Monochrome service folders"
                    description="Draw service folders without color"/>
            <action id="com.github.khopland.symbols.ToggleReducedFolderColor"
                    class="com.github.khopland.symbols.ToggleReducedFolderColorAction"
                    text="Reduce service-folder color"
                    description="Use softer service-folder colors"/>
            <action id="com.github.khopland.symbols.ToggleArchitectureFolders"
                    class="com.github.khopland.symbols.ToggleArchitectureFoldersAction"
                    text="JVM architecture folders"
                    description="Show distinct icons for controller, service, repository, and similar packages"/>
            <action id="com.github.khopland.symbols.ToggleStereotypeBadges"
                    class="com.github.khopland.symbols.ToggleStereotypeBadgesAction"
                    text="Spring stereotype badges"
                    description="Badge native class icons for Spring controllers, services, repositories, configuration, and JPA entities"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </group>
        <action id="com.github.khopland.symbols.ExplainIcon"
                class="com.github.khopland.symbols.ExplainIconAction"
                text="Explain This Icon"
                description="Show which Emberkai rule or mapping selected this icon">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AssignModuleAccentColor"
                class="com.github.khopland.symbols.AssignModuleAccentAction"
                text="Assign Module Accent Color…"
                description="Pin a folder accent color for the module that owns this directory">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.ResetAllModuleAccentColors"
                class="com.github.khopland.symbols.ResetAllModuleAccentColorsAction"
                text="Reset All Module Accent Colors"
                description="Return every module to its automatic accent color">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AuditProjectIconCoverage"
                class="com.github.khopland.symbols.AuditProjectIconCoverageAction"
                text="Audit Project Icon Coverage"
                description="Find files that use generic or unmapped icons">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.AuditDirectoryIconCoverage"
                class="com.github.khopland.symbols.AuditDirectoryIconCoverageAction"
                text="Audit Icon Coverage"
                description="Find generic or unmapped icons under this directory">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.OverrideIcon"
                class="com.github.khopland.symbols.OverrideIconAction"
                text="Override This Icon…"
                description="Create a project-local icon override for this file or folder">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.OpenIconOverrides"
                class="com.github.khopland.symbols.OpenIconOverridesAction"
                text="Open Icon Overrides File"
                description="Open or create .idea/emberkai-icons.properties">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.ReloadIconOverrides"
                class="com.github.khopland.symbols.ReloadIconOverridesAction"
                text="Reload Icon Overrides"
                description="Reload project-local icon overrides">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.github.khopland.symbols.BrowseIconCatalog"
                class="com.github.khopland.symbols.BrowseIconCatalogAction"
                text="Browse Bundled Icons"
                description="Search every bundled icon and copy its mapping key or path">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
