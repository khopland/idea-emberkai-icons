<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Without Git no branch comparison exists, so the Changed on this branch lens is not offered. -->
        <projectService
            serviceInterface="com.github.khopland.symbols.lens.BranchChanges"
            serviceImplementation="com.github.khopland.symbols.lens.GitBranchChanges"/>
        <!-- Without Git, migrations get duplicate-version warnings only, not out-of-order ones. -->
        <projectService
            serviceInterface="com.github.khopland.symbols.badges.MigrationBranchBase"
            serviceImplementation="com.github.khopland.symbols.badges.GitMigrationBranchBase"/>
    </extensions>
</idea-plugin>
