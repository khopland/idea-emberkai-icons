<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Without VCS support no exposure service exists, so secret files keep unbadged icons. -->
        <projectService
            serviceInterface="com.github.khopland.symbols.SecretFileExposure"
            serviceImplementation="com.github.khopland.symbols.VcsSecretFileExposure"/>
    </extensions>
</idea-plugin>
